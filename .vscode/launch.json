{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Build and debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bagunceitor",
            "windows": {
                "program": "${workspaceFolder}/bagunceitor.exe",
                "MIMode": "gdb",
                "miDebuggerPath": "gdb.exe"
            },
            "args": ["predio32.jpg", "trabalho1-ProgBN"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "linux": { "MIMode": "gdb", "miDebuggerPath": "/usr/bin/gdb" },
            "osx": { "MIMode": "lldb" },
            "setupCommands": [
                {
                    "description": "Habilitar a reformatação automática para gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build"
        }
    ]
}
